# ── PKI artifacts (ansible/pki/) ──────────────────────────────────────────────
# Generated fresh on every cluster provision by the pki role.
# Private keys, certificates, serial files, kubeconfigs, OpenSSL configs,
# the encryption-config (contains the AES-CBC secret), and the bootstrap token
# are all produced at runtime and must never be committed.
ansible/pki/*.key
ansible/pki/*.csr
ansible/pki/*.crt
ansible/pki/*.srl
ansible/pki/*.cnf
ansible/pki/*.kubeconfig
ansible/pki/encryption-config.yaml
ansible/pki/bootstrap-token.txt

# Catch kubeconfig files dropped anywhere else in the tree
*.kubeconfig
kubeconfig
**/kubeconfig

# Catch any stray private-key or cert files outside pki/
# (PKCS1/PKCS8 PEM, PKCS12 bundles, EC private keys)
*.pem
*.p12
*.pfx
*.p8
*.der

# ── Terraform state & generated files ─────────────────────────────────────────
# State files embed resource IDs, IPs, and can contain sensitive output values.
# terraform.tfvars.json is auto-generated by up.sh; never edit or commit it.
# .terraform/ is the provider cache (large binaries, not secrets, but still noise).
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfvars.json
terraform/.terraform/
terraform/.terraform.lock.hcl

# Terraform override files are a common place for local secret injection
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# Any .tfvars file (plain or JSON) in the terraform directory may carry secrets
terraform/*.tfvars
# (terraform.tfvars.json already listed above; this catches the plain-text form)

# Terraform crash log — written on panic, contains internal state fragments
crash.log
crash.*.log

# Terraform plan files can embed secrets from state
*.tfplan

# ── Vagrant state ─────────────────────────────────────────────────────────────
# .vagrant/ contains per-VM SSH private keys, machine UUIDs, and provider state.
.vagrant/

# ── Ansible runtime files ─────────────────────────────────────────────────────
# Fact cache populated by gather_facts (may include hostnames, IPs, hardware IDs)
/tmp/ansible_facts_cache/
.ansible_facts_cache/

# Retry files written when a playbook partially fails (contain host lists)
*.retry

# Ansible log file if ANSIBLE_LOG_PATH is set to a file in this repo
ansible.log
*.ansible.log

# Ansible Vault password files (commonly named one of these)
.vault_pass
.vault_password
vault_pass
vault_password
*.vault_pass
*.vault_password

# ── Environment / secrets files ───────────────────────────────────────────────
# .env files often hold cloud credentials, API tokens, or override variables
.env
.env.*
.envrc          # direnv — may source secret vars
!.envrc.example # allow a sanitised example to be committed

# ── SSH material ──────────────────────────────────────────────────────────────
# Private key files (any algorithm name or suffix)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
authorized_keys
# known_hosts leaks cluster IPs — keep it out of the repo
known_hosts

# ── Cloud provider credential files ───────────────────────────────────────────
# These are sometimes accidentally dropped into project directories
credentials
credentials.json
service-account.json
gcp-credentials.json
*.credentials
*_credentials.json
.aws/
.gcloud/
.azure/

# ── Log files ─────────────────────────────────────────────────────────────────
# Kubernetes audit.log and any other log files that could capture secrets
*.log
logs/

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
