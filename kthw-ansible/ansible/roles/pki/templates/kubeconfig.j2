apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: {{ ca_crt_b64 }}
    server: {{ server }}
  name: {{ k8s_cluster_name }}
contexts:
- context:
    cluster: {{ k8s_cluster_name }}
    user: {{ kube_user }}
  name: default
current-context: default
preferences: {}
users:
- name: {{ kube_user }}
  user:
    client-certificate-data: {{ client_crt_b64 }}
    client-key-data: {{ client_key_b64 }}
